{
  "name": "scoutbot",
  "version": "0.1.0",
  "description": "Discord bot for Cub Scout pack event signups and attendance tracking",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24 <24.19.0"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "web": "tsx watch src/web/server.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "deploy-commands": "tsx src/deploy-commands.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "better-sqlite3": "^11.3.0",
    "discord.js": "^14.16.3",
    "dotenv": "^16.4.5",
    "drizzle-orm": "^0.36.4",
    "express": "^5.2.1",
    "express-session": "^1.19.0",
    "luxon": "^3.7.2"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.11",
    "@types/express": "^5.0.6",
    "@types/express-session": "^1.19.0",
    "@types/luxon": "^3.7.4",
    "@types/node": "^22.10.2",
    "drizzle-kit": "^0.28.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
