# Copy this file to .env and fill in real values. Never commit .env.

# Discord bot token, from the Bot tab of your application at
# https://discord.com/developers/applications
DISCORD_TOKEN=

# Application (client) ID, from the General Information tab of the same
# application page.
DISCORD_CLIENT_ID=

# Optional: a guild ID to scope slash command registration to during
# development. Commands register instantly in one server instead of taking
# up to an hour to propagate globally. Leave unset for production.
DISCORD_DEV_GUILD_ID=

# Path to the SQLite database file. Defaults to ./scoutbot.db if unset.
DATABASE_PATH=./scoutbot.db

# HTTPS or SSH URL of the private repo the backup cron job pushes encrypted
# nightly dumps to. Only needed on the deploy target, not for local dev.
BACKUP_REPO_URL=

# Public half of the age keypair used to encrypt backups before they're
# pushed. Generate with `age-keygen`. The private key stays only on the Pi
# (and a password manager backup) — never put it in this file or commit it.
AGE_PUBLIC_KEY=
