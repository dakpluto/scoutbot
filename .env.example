# Copy this file to .env and fill in real values. Never commit .env.

# Discord bot token, from the Bot tab of your application at
# https://discord.com/developers/applications
DISCORD_TOKEN=

# Application (client) ID, from the General Information tab of the same
# application page.
DISCORD_CLIENT_ID=

# Optional: a guild ID to scope slash command registration to during
# development. Commands register instantly in one server instead of taking
# up to an hour to propagate globally. Leave unset for production.
DISCORD_DEV_GUILD_ID=

# Path to the SQLite database file. Defaults to ./scoutbot.db if unset.
DATABASE_PATH=./scoutbot.db

# HTTPS or SSH URL of the private repo the backup cron job pushes encrypted
# nightly dumps to. Only needed on the deploy target, not for local dev.
BACKUP_REPO_URL=

# Public half of the age keypair used to encrypt backups before they're
# pushed. Generate with `age-keygen`. The private key stays only on the Pi
# (and a password manager backup) — never put it in this file or commit it.
AGE_PUBLIC_KEY=

# Optional: shown by /portal. Set this to the web portal's public URL once
# it's deployed (e.g. a Tailscale Funnel or Cloudflare Tunnel URL).
PORTAL_URL=

# --- Web portal (npm run web / src/web/server.ts) — not read by the bot ---

# OAuth2 client secret, from the OAuth2 tab of the same Discord application.
# Needed for "Log in with Discord" on the web portal. Treat like a password.
DISCORD_CLIENT_SECRET=

# The one guild ID this web portal instance serves.
WEB_GUILD_ID=

# Base URL the portal is reachable at, used to build the OAuth redirect URI
# as `${WEB_BASE_URL}/auth/callback` — that exact URL must also be added
# under the application's OAuth2 > Redirects in the Developer Portal.
WEB_BASE_URL=http://localhost:3000

# Optional: port the portal listens on. Defaults to 3000.
WEB_PORT=3000

# Random string used to sign session cookies. Generate with e.g.
# `node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"`.
SESSION_SECRET=
